# PostgreSQL used by FastAPI and Alembic
POSTGRES_DB=careeros
POSTGRES_USER=careeros
POSTGRES_PASSWORD=change-me-locally
DATABASE_URL=postgresql+psycopg://careeros:change-me-locally@localhost:5432/careeros

# Authentication. Replace outside local development.
JWT_SECRET_KEY=replace-with-a-long-random-secret
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Deterministic recruiter demo defaults. Tests and CI stay on this path.
CAREEROS_PREVIEW_MODE=false
USE_LLM_RESUME_INTELLIGENCE=false
# deterministic: local feature-hash-v1, no network.
# openai: live semantic embeddings when OPENAI_API_KEY is set. A missing key
# falls back to deterministic. Do not commit a real key.
RAG_EMBEDDING_PROVIDER=deterministic
RAG_EMBEDDING_MODEL=text-embedding-3-small
# Leave unset to use the model default (1536 for text-embedding-3-small).
# RAG_EMBEDDING_DIMENSIONS=
RAG_VECTOR_STORE=local
PROVIDER_TIMEOUT_SECONDS=30

# Optional live mode. Leave blank for deterministic fallback.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# Browser origins allowed to call FastAPI.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
VITE_API_BASE_URL=/api
VITE_PREVIEW_MODE=false

# Optional private local seed overrides. Keep real values only in ignored .env files.
CAREEROS_DEVELOPER_EMAIL=ahmed.raza@example.com
CAREEROS_DEVELOPER_PHONE=
